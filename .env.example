# Server
PORT=3000
NODE_ENV=development

# TallyPrime (runs on the same PC; the integration interface must be enabled in TallyPrime)
TALLY_PRIME_URL=http://127.0.0.1:9000
# Optional: company to use when several are open. Leave blank to use the only open company.
TALLY_PRIME_COMPANY=
TALLY_PRIME_TIMEOUT_MS=15000

# Admin bearer token for writes and company management (at least 32 characters).
# Leave unset to disable those routes. Public reads do not need it.
ADMIN_API_TOKEN=
